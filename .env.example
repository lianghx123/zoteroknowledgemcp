# Required. Use your own Zotero 10 executable path.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH="C:/Program Files/Zotero/zotero.exe"

# Optional. Omit both to use Scaffold's isolated .scaffold/profile and .scaffold/data.
# To use an existing *development* profile, set BOTH paths (never use daily production data).
# ZOTERO_PLUGIN_PROFILE_PATH="E:/ZoteroDev/profile"
# ZOTERO_PLUGIN_DATA_DIR="E:/ZoteroDev/data"
