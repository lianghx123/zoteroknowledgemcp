{
  "name": "zotero-knowledge-mcp",
  "version": "0.2.0-preview.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "description": "Vector-based Zotero knowledge base with structured literature access through MCP",
  "author": {
    "name": "lianghx123",
    "url": "https://github.com/lianghx123"
  },
  "homepage": "https://github.com/lianghx123/zoteroknowledgemcp",
  "bugs": {
    "url": "https://github.com/lianghx123/zoteroknowledgemcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lianghx123/zoteroknowledgemcp.git"
  },
  "config": {
    "prefsPrefix": "extensions.zotero.knowledgemcp"
  },
  "scripts": {
    "release:prepare": "node scripts/prepare-release.mjs",
    "updates:check": "node scripts/update-feed.mjs",
    "database:check": "node scripts/promote-database-schema.mjs --check && node scripts/generate-database-dictionary.mjs --check",
    "init:src": "node scripts/initialize-source-layout.mjs",
    "dev": "zotero-plugin serve",
    "build": "node scripts/check-usearch.mjs && node scripts/prepare-licenses.mjs && node scripts/prepare-locales.mjs && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@fluent/bundle": "^0.19.1",
    "@fluent/syntax": "^0.19.0",
    "@types/markdown-it": "14.1.2",
    "adm-zip": "0.5.18",
    "jsdom": "26.1.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "0.8.8"
  },
  "overrides": {
    "@swc/core": "1.15.13"
  },
  "dependencies": {
    "entities": "4.5.0",
    "katex": "0.19.1",
    "kysely": "0.29.7",
    "markdown-it": "14.3.3"
  }
}
